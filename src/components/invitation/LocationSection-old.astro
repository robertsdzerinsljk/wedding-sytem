<script>
  const section = document.querySelector<HTMLElement>("#vieta");

  if (section) {
    const galleryDialog = document.querySelector<HTMLDialogElement>("[data-location-gallery]");
    const galleryTriggers = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-location-image]"));
    const galleryImage = galleryDialog?.querySelector<HTMLImageElement>("[data-gallery-image]");
    const galleryTitle = galleryDialog?.querySelector<HTMLElement>("[data-gallery-title]");
    const galleryDescription = galleryDialog?.querySelector<HTMLElement>("[data-gallery-description]");
    const galleryCount = galleryDialog?.querySelector<HTMLElement>("[data-gallery-count]");
    const galleryPrev = galleryDialog?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const galleryNext = galleryDialog?.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const galleryClose = galleryDialog?.querySelector<HTMLButtonElement>("[data-close-location-gallery]");

    let galleryIndex = 0;

    const renderGallery = () => {
      const trigger = galleryTriggers[galleryIndex];
      if (!trigger || !galleryImage || !galleryTitle || !galleryDescription || !galleryCount) return;

      const src = trigger.dataset.imageSrc ?? "";
      const title = trigger.dataset.imageTitle ?? "";
      const description = trigger.dataset.imageDescription ?? "";

      galleryImage.src = src;
      galleryImage.alt = title;
      galleryTitle.textContent = title;
      galleryDescription.textContent = description;
      galleryCount.textContent = `${String(galleryIndex + 1).padStart(2, "0")} / ${String(galleryTriggers.length).padStart(2, "0")}`;
    };

    galleryTriggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        galleryIndex = index;
        renderGallery();
        galleryDialog?.showModal();
      });
    });

    galleryPrev?.addEventListener("click", () => {
      galleryIndex = (galleryIndex - 1 + galleryTriggers.length) % galleryTriggers.length;
      renderGallery();
    });

    galleryNext?.addEventListener("click", () => {
      galleryIndex = (galleryIndex + 1) % galleryTriggers.length;
      renderGallery();
    });

    galleryClose?.addEventListener("click", () => galleryDialog?.close());

    galleryDialog?.addEventListener("click", (event) => {
      if (event.target === galleryDialog) galleryDialog.close();
    });

    galleryDialog?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        galleryIndex = (galleryIndex - 1 + galleryTriggers.length) % galleryTriggers.length;
        renderGallery();
      }

      if (event.key === "ArrowRight") {
        galleryIndex = (galleryIndex + 1) % galleryTriggers.length;
        renderGallery();
      }
    });

    const mapDialog = document.querySelector<HTMLDialogElement>("[data-location-map]");
    const mapOpen = section.querySelector<HTMLButtonElement>("[data-open-location-map]");
    const mapClose = mapDialog?.querySelector<HTMLButtonElement>("[data-close-location-map]");

    mapOpen?.addEventListener("click", () => mapDialog?.showModal());
    mapClose?.addEventListener("click", () => mapDialog?.close());

    mapDialog?.addEventListener("click", (event) => {
      if (event.target === mapDialog) mapDialog.close();
    });
  }
</script>
