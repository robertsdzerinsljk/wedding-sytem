---
import { weddingVenue } from "../../data/wedding";

/*
 * Replace these three files with your final photos later.
 * Keep the filenames/paths the same and the section updates automatically.
 */
const locationImages = {
  ceremony: "/images/location-ceremony.jpg",
  celebration: "/images/location-celebration.jpg",
  stay: "/images/location-stay.jpg",
};

/*
 * Card copy is kept here on purpose so each image has its own identity.
 * Change only these strings if you later want different wording.
 */
const locationCopy = {
  ceremony: {
    number: "01",
    label: "Ceremonija",
    title: "Ceremonija pie ezera",
    description: "Šeit sāksies mūsu diena — pie ezera, zem klajas debess.",
  },
  celebration: {
    number: "02",
    label: "Svinības",
    title: "Svinību zāle",
    description: "Te turpināsim ar vakariņām, tostiem un dejām.",
  },
  stay: {
    number: "03",
    label: "Nakšņošana",
    title: "Jūsu naktsmājas",
    description: "Nakšņošanas informācija ir norādīta personalizēti tieši jums.",
  },
};

/**
 * The highlighted house can later come from the personalised invite data:
 * <LocationSection assignedHouseId={activeInvitee.houseId} />
 */
type Props = {
  assignedHouseId?: string;
};

const { assignedHouseId = "house-3" } = Astro.props;

const mapHouses = [
  { id: "house-1", x: 935, y: 164, rotate: -18 },
  { id: "house-2", x: 1008, y: 220, rotate: 12 },
  { id: "house-3", x: 924, y: 286, rotate: -10 },
  { id: "house-4", x: 1050, y: 330, rotate: 15 },
  { id: "house-5", x: 924, y: 390, rotate: -18 },
  { id: "house-6", x: 1038, y: 450, rotate: 18 },
];
---

<section class="wedding-section wedding-section--tinted location-section" id="vieta">
  <div class="section-inner location-shell">
    <header class="location-heading">
      <div class="location-heading__title">
        <p class="section-kicker">Vieta</p>
        <h2 class="section-title">Kur tiekamies</h2>
      </div>

      <div class="location-heading__aside">
        <p class="location-heading__copy">
          Ceremonija, svinības un nakšņošana vienuviet - lai visa diena ritētu
          mierīgi.
        </p>
        <p class="location-heading__venue">
          <span>{weddingVenue.name}</span>
          <span aria-hidden="true">·</span>
          <span>{weddingVenue.address}</span>
        </p>
      </div>
    </header>

    <div class="location-showcase">
      <article class="location-card location-card--feature">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.ceremony}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <button
          class="location-card__expand"
          type="button"
          data-location-image
          data-image-src={locationImages.ceremony}
          data-image-title={locationCopy.ceremony.title}
          data-image-description={locationCopy.ceremony.description}
          aria-label={`Atvērt ${locationCopy.ceremony.title} attēlu`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.ceremony.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.ceremony.label}</span>
        </div>

        <div class="location-card__content">
          <div class="location-card__text">
            <h3>{locationCopy.ceremony.title}</h3>
            <p>{locationCopy.ceremony.description}</p>
          </div>
        </div>
      </article>

      <article class="location-card location-card--secondary">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.celebration}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <button
          class="location-card__expand"
          type="button"
          data-location-image
          data-image-src={locationImages.celebration}
          data-image-title={locationCopy.celebration.title}
          data-image-description={locationCopy.celebration.description}
          aria-label={`Atvērt ${locationCopy.celebration.title} attēlu`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.celebration.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.celebration.label}</span>
        </div>

        <div class="location-card__content">
          <div class="location-card__text">
            <h3>{locationCopy.celebration.title}</h3>
            <p>{locationCopy.celebration.description}</p>
          </div>
        </div>
      </article>

      <article class="location-card location-card--stay">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.stay}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <button
          class="location-card__expand"
          type="button"
          data-location-image
          data-image-src={locationImages.stay}
          data-image-title={locationCopy.stay.title}
          data-image-description={locationCopy.stay.description}
          aria-label={`Atvērt ${locationCopy.stay.title} attēlu`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.stay.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.stay.label}</span>
        </div>

        <div class="location-card__content location-card__content--stay">
          <div class="location-card__text">
            <p class="location-card__personal">Jūsu ielūgumam</p>
            <h3>{locationCopy.stay.title}</h3>
            <p>{locationCopy.stay.description}</p>
          </div>
        </div>
      </article>
    </div>

    <footer class="location-footer">
      <button class="location-footer__map" type="button" data-open-location-map>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m3.5 6.3 5-2.3 7 2.3 5-2.3v13.7l-5 2.3-7-2.3-5 2.3V6.3Z" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
          <path d="M8.5 4v13.7M15.5 6.3V20" fill="none" stroke="currentColor" stroke-width="1.45" />
        </svg>
        <span>Apskatīt teritorijas plānu</span>
        <span aria-hidden="true">↗</span>
      </button>
    </footer>
  </div>
</section>


<!-- Photo viewer -->
<dialog class="location-lightbox" data-location-gallery aria-label="Vietas attēlu galerija">
  <div class="location-lightbox__panel">
    <button class="location-overlay__close" type="button" data-close-location-gallery aria-label="Aizvērt galeriju">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 6.5 11 11M17.5 6.5l-11 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>

    <div class="location-lightbox__media">
      <img src="" alt="" data-gallery-image />
    </div>

    <div class="location-lightbox__footer">
      <div class="location-lightbox__copy">
        <p data-gallery-count>01 / 03</p>
        <h3 data-gallery-title></h3>
        <span data-gallery-description></span>
      </div>

      <div class="location-lightbox__controls" aria-label="Galerijas navigācija">
        <button type="button" data-gallery-prev aria-label="Iepriekšējais attēls">←</button>
        <button type="button" data-gallery-next aria-label="Nākamais attēls">→</button>
      </div>
    </div>
  </div>
</dialog>

<!-- Stylised territory plan: this is intentionally NOT the supplied satellite screenshot. -->
<dialog class="location-map-modal" data-location-map aria-labelledby="location-map-title">
  <div class="location-map-modal__panel">
    <header class="location-map-modal__header">
      <div>
        <p class="section-kicker">Niedras</p>
        <h3 id="location-map-title">Teritorijas plāns</h3>
        <p>Ceremonija, svinību vieta un jūsu naktsmāja vienā skatā.</p>
      </div>

      <button class="location-overlay__close location-overlay__close--map" type="button" data-close-location-map aria-label="Aizvērt teritorijas plānu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 6.5 11 11M17.5 6.5l-11 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </header>

    <div class="estate-map-scroll" data-estate-map-scroll>
      <svg class="estate-map" viewBox="0 0 1200 680" role="img" aria-labelledby="estate-map-title estate-map-desc">
        <title id="estate-map-title">Niedras teritorijas ilustratīvs plāns</title>
        <desc id="estate-map-desc">Stilizēta teritorijas karte ar ceremonijas vietu pie ūdens, svinību zāli, iebraucamo ceļu un naktsmāju grupu. Jūsu naktsmāja ir iekrāsota zelta tonī.</desc>

        <defs>
          <pattern id="map-grain" width="26" height="26" patternUnits="userSpaceOnUse">
            <circle cx="5" cy="8" r="1" fill="#697156" opacity=".08" />
            <circle cx="18" cy="17" r=".8" fill="#697156" opacity=".07" />
          </pattern>
          <filter id="map-shadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#26301d" flood-opacity=".16" />
          </filter>
        </defs>

        <rect width="1200" height="680" rx="34" fill="#ece7da" />
        <rect width="1200" height="680" rx="34" fill="url(#map-grain)" />

        <!-- landscape masses -->
        <path d="M0 0h470c-31 61-49 113-41 170 6 47-11 82-57 108-72 40-165 34-243 6C79 266 35 237 0 204V0Z" fill="#d7dcc8" />
        <path d="M777 0h423v680H885c-13-64-2-117 30-161 34-47 28-99-19-143-43-41-66-91-51-149 17-68 2-140-68-227Z" fill="#d0d7c3" />
        <path d="M40 526c98-65 187-69 275-23 71 37 132 46 197 18 54-23 111-20 170 10 75 38 129 83 163 149H40V526Z" fill="#dde0cf" opacity=".84" />

        <!-- water / ceremony edge -->
        <path d="M0 44c71 11 128 41 171 89 35 40 61 79 95 98-42 33-94 51-157 48-43-2-79-11-109-28V44Z" fill="#b8c9bd" />
        <path d="M0 242c61 24 118 27 171 10 35-11 66-28 94-49" fill="none" stroke="#f7f3e9" stroke-width="12" opacity=".9" />

        <!-- main roads based on the reference layout -->
        <path d="M1189 22C1106 50 1053 89 1010 142c-44 54-91 92-147 113-62 24-103 56-123 97-17 35-42 63-76 83-57 34-91 82-103 144" fill="none" stroke="#c6bda9" stroke-width="34" stroke-linecap="round" />
        <path d="M1189 22C1106 50 1053 89 1010 142c-44 54-91 92-147 113-62 24-103 56-123 97-17 35-42 63-76 83-57 34-91 82-103 144" fill="none" stroke="#eee8dc" stroke-width="22" stroke-linecap="round" />
        <path d="M750 349c-92-30-167-35-236-10-70 25-130 67-184 126-58 64-106 106-170 130" fill="none" stroke="#c6bda9" stroke-width="25" stroke-linecap="round" />
        <path d="M750 349c-92-30-167-35-236-10-70 25-130 67-184 126-58 64-106 106-170 130" fill="none" stroke="#eee8dc" stroke-width="15" stroke-linecap="round" />

        <!-- tennis court -->
        <g transform="translate(430 112) rotate(-18 55 34)" opacity=".86">
          <rect width="110" height="68" rx="7" fill="#9bac91" />
          <rect x="7" y="7" width="96" height="54" rx="2" fill="none" stroke="#f1eadc" stroke-width="2" />
          <path d="M55 7v54M7 34h96" stroke="#f1eadc" stroke-width="1.4" />
        </g>

        <!-- ceremony deck -->
        <g class="estate-landmark estate-landmark--ceremony" transform="translate(250 208) rotate(-7)">
          <path d="M-72-30h144v60H-72z" rx="12" fill="#f5f0e6" stroke="#a59a77" stroke-width="3" filter="url(#map-shadow)" />
          <path d="M-55-12h110M-55 4h110M-55 20h110" stroke="#d5ccb7" stroke-width="3" stroke-linecap="round" />
          <circle cx="0" cy="0" r="7" fill="#333A24" />
        </g>

        <!-- celebration hall -->
        <g class="estate-landmark estate-landmark--hall" transform="translate(640 491) rotate(4)">
          <rect x="-104" y="-38" width="208" height="76" rx="9" fill="#f8f4eb" stroke="#91886f" stroke-width="3" filter="url(#map-shadow)" />
          <path d="M-88-26h176L70 0H-70L-88-26Z" fill="#646b58" />
          <path d="M-70 0h140v25H-70z" fill="#dad3c3" />
        </g>

        <!-- other roof masses visible in the reference -->
        <g transform="translate(720 232) rotate(-18)" opacity=".8">
          <rect x="-42" y="-22" width="84" height="44" rx="5" fill="#8b8a7c" />
          <path d="M-48-18 0-42l48 24Z" fill="#5b6251" />
        </g>
        <g transform="translate(350 572) rotate(24)" opacity=".72">
          <rect x="-60" y="-26" width="120" height="52" rx="6" fill="#9b998b" />
          <path d="M-68-20 0-50l68 30Z" fill="#656b5b" />
        </g>

        <!-- guest houses -->
        {mapHouses.map((house, index) => (
          <g
            class:list={["estate-house", house.id === assignedHouseId && "is-assigned"]}
            transform={`translate(${house.x} ${house.y}) rotate(${house.rotate})`}
            data-house-id={house.id}
          >
            <rect class="estate-house__base" x="-32" y="-18" width="64" height="36" rx="6" filter="url(#map-shadow)" />
            <path class="estate-house__roof" d="M-38-12 0-36l38 24-7 4L0-27-31-8Z" />
            <path class="estate-house__ridge" d="M0-28v40" />
            <text x="0" y="42" text-anchor="middle">{String(index + 1).padStart(2, "0")}</text>
          </g>
        ))}

        <!-- labels -->
        <g class="estate-label" transform="translate(140 322)">
          <circle r="19" fill="#333A24" />
          <text x="0" y="5" text-anchor="middle">01</text>
          <path d="M28 0h86" stroke="#7c806c" stroke-width="1" />
          <text class="estate-label__name" x="128" y="5">Ceremonija pie ezera</text>
        </g>

        <g class="estate-label" transform="translate(559 590)">
          <circle r="19" fill="#333A24" />
          <text x="0" y="5" text-anchor="middle">02</text>
          <path d="M28 0h65" stroke="#7c806c" stroke-width="1" />
          <text class="estate-label__name" x="106" y="5">Svinību zāle</text>
        </g>

        {mapHouses.map((house) => house.id === assignedHouseId && (
          <g class="estate-assigned-label" transform={`translate(${house.x - 17} ${house.y + 70})`}>
            <path d="M17-43V-12" stroke="#a88d4d" stroke-width="2" stroke-dasharray="4 5" />
            <rect x="-55" y="-12" width="144" height="36" rx="18" fill="#fffaf0" stroke="#b49a5d" />
            <text x="17" y="11" text-anchor="middle">Jūsu naktsmāja</text>
          </g>
        ))}

        <!-- entrance -->
        <g transform="translate(1082 78)">
          <circle r="8" fill="#b4995c" />
          <text class="estate-map__small-label" x="-20" y="3" text-anchor="end">Iebraukšana</text>
        </g>
      </svg>
    </div>

    <footer class="location-map-modal__footer">
      <div class="location-map-legend">
        <span><i class="legend-dot legend-dot--dark"></i>Ceremonija / svinības</span>
        <span><i class="legend-dot legend-dot--gold"></i>Jūsu naktsmāja</span>
      </div>
      <p class="location-map-modal__hint">Plāns ir ilustratīvs un paredzēts ērtai orientācijai teritorijā.</p>
    </footer>
  </div>
</dialog>

<style>
  .location-section {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(74px, 7.5vh, 100px) clamp(28px, 4vh, 48px);
  }

  .location-section::before {
    content: "";
    position: absolute;
    width: min(42vw, 620px);
    aspect-ratio: 1;
    right: -15%;
    top: 5%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(129, 120, 81, 0.09) 0%,
      rgba(129, 120, 81, 0) 70%
    );
    pointer-events: none;
  }

  .location-shell {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .location-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
    align-items: end;
    gap: clamp(34px, 7vw, 100px);
    margin-bottom: clamp(20px, 3vh, 34px);
  }

  .location-heading__aside {
    max-width: 38rem;
    margin: 0 0 0.18rem;
    padding-left: 24px;
    border-left: 1px solid color-mix(in srgb, var(--gold) 48%, transparent);
  }

  .location-heading__copy {
    max-width: 35rem;
    margin: 0;
    color: color-mix(in srgb, var(--olive-dark) 78%, transparent);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.62;
  }

  .location-heading__venue {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 10px 0 0;
    color: color-mix(in srgb, var(--olive-dark) 58%, transparent);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .location-heading__venue span:first-child {
    color: color-mix(in srgb, var(--olive-dark) 82%, transparent);
  }

  .location-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.48fr) minmax(300px, 0.82fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.45vw, 20px);
    height: clamp(410px, 52vh, 545px);
    min-height: 410px;
  }

  .location-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 0;
    border-radius: clamp(18px, 2vw, 28px);
    background: #cec8b8;
    box-shadow: 0 18px 54px rgba(46, 43, 31, 0.1);
  }

  .location-card--feature {
    grid-row: 1 / 3;
  }

  .location-card__image {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-color: #cec8b8;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    transform: scale(1.01);
    transition:
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /*
   * Stronger bottom shading is deliberate: the photography still stays visible,
   * but the text remains readable regardless of which final images you use.
   */
  .location-card__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgba(13, 16, 10, 0.13) 0%,
        rgba(13, 16, 10, 0.03) 37%,
        rgba(13, 16, 10, 0.18) 56%,
        rgba(13, 16, 10, 0.84) 100%
      ),
      linear-gradient(105deg, rgba(26, 31, 20, 0.2), transparent 54%);
  }

  .location-card--secondary .location-card__shade,
  .location-card--stay .location-card__shade {
    background:
      linear-gradient(
        180deg,
        rgba(13, 16, 10, 0.16) 0%,
        rgba(13, 16, 10, 0.05) 30%,
        rgba(13, 16, 10, 0.34) 57%,
        rgba(13, 16, 10, 0.88) 100%
      ),
      linear-gradient(105deg, rgba(26, 31, 20, 0.18), transparent 58%);
  }

  .location-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: inherit;
    pointer-events: none;
  }

  .location-card__meta {
    position: absolute;
    top: clamp(18px, 2vw, 26px);
    left: clamp(20px, 2.4vw, 30px);
    right: clamp(20px, 2.4vw, 30px);
    display: grid;
    grid-template-columns: auto minmax(34px, 1fr) auto;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(0.63rem, 0.58vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(10, 13, 8, 0.62);
  }

  .location-card__number {
    opacity: 0.8;
  }

  .location-card__meta-line {
    height: 1px;
    background: rgba(255, 255, 255, 0.52);
    box-shadow: 0 1px 8px rgba(10, 13, 8, 0.28);
  }

  .location-card__content {
    position: absolute;
    inset: auto clamp(22px, 2.6vw, 34px) clamp(22px, 2.7vw, 32px);
    color: #fff;
  }

  .location-card__text {
    min-width: 0;
    max-width: 40rem;
  }

  .location-card__content h3 {
    max-width: 18ch;
    margin: 0 0 8px;
    color: #fff !important;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.2rem, 3.6vw, 3.8rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
    text-shadow: 0 3px 24px rgba(7, 10, 6, 0.72);
  }

  .location-card--secondary .location-card__content h3,
  .location-card--stay .location-card__content h3 {
    max-width: 15ch;
    font-size: clamp(1.85rem, 2.35vw, 2.7rem);
  }

  .location-card__content p {
    max-width: 42ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.94) !important;
    font-size: clamp(0.82rem, 0.83vw, 0.92rem);
    font-weight: 500;
    line-height: 1.5;
