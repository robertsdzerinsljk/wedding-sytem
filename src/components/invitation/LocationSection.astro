---
import { weddingVenue } from "../../data/wedding";

/*
 * Replace these three files with your final photos later.
 * Keep the filenames/paths the same and the section updates automatically.
 */
const locationImages = {
  ceremony: "/images/location-ceremony.jpg",
  celebration: "/images/location-celebration.jpg",
  stay: "/images/location-stay.jpg",
};

/*
 * Card copy is kept here on purpose so each image has its own identity.
 * Change only these strings if you later want different wording.
 */
const locationCopy = {
  ceremony: {
    number: "01",
    label: "Ceremonija",
    title: "Ceremonija pie ezera",
    description: "Šeit sāksies mūsu diena — pie ezera, zem klajas debess.",
  },
  celebration: {
    number: "02",
    label: "Svinības",
    title: "Svinību zāle",
    description: "Te turpināsim ar vakariņām, tostiem un dejām.",
  },
  stay: {
    number: "03",
    label: "Nakšņošana",
    title: "Jūsu naktsmājas",
    description: "Nakšņošanas informācija būs norādīta personalizēti tieši jums.",
  },
};
---

<section class="wedding-section wedding-section--tinted location-section" id="vieta">
  <div class="section-inner location-shell">
    <header class="location-heading">
      <div class="location-heading__title">
        <p class="section-kicker">Vieta</p>
        <h2 class="section-title">Kur tiekamies</h2>
      </div>

      <div class="location-heading__aside">
        <p class="location-heading__copy">
          Ceremonija, svinības un nakšņošana vienuviet - lai visa diena ritētu
          mierīgi.
        </p>
        <p class="location-heading__venue">
          <span>{weddingVenue.name}</span>
          <span aria-hidden="true">·</span>
          <span>{weddingVenue.address}</span>
        </p>
      </div>
    </header>

    <div class="location-showcase">
      <article class="location-card location-card--feature">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.ceremony}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.ceremony.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.ceremony.label}</span>
        </div>

        <div class="location-card__content">
          <div class="location-card__text">
            <h3>{locationCopy.ceremony.title}</h3>
            <p>{locationCopy.ceremony.description}</p>
          </div>
        </div>
      </article>

      <article class="location-card location-card--secondary">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.celebration}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.celebration.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.celebration.label}</span>
        </div>

        <div class="location-card__content">
          <div class="location-card__text">
            <h3>{locationCopy.celebration.title}</h3>
            <p>{locationCopy.celebration.description}</p>
          </div>
        </div>
      </article>

      <article class="location-card location-card--stay">
        <div
          class="location-card__image"
          style={`background-image: url('${locationImages.stay}')`}
          aria-hidden="true"
        ></div>
        <div class="location-card__shade" aria-hidden="true"></div>

        <div class="location-card__meta" aria-hidden="true">
          <span class="location-card__number">{locationCopy.stay.number}</span>
          <span class="location-card__meta-line"></span>
          <span>{locationCopy.stay.label}</span>
        </div>

        <div class="location-card__content location-card__content--stay">
          <div class="location-card__text">
            <p class="location-card__personal">Jūsu ielūgumam</p>
            <h3>{locationCopy.stay.title}</h3>
            <p>{locationCopy.stay.description}</p>
          </div>
        </div>
      </article>
    </div>

    <footer class="location-footer">
      <div class="location-footer__note">
        <span aria-hidden="true"></span>
        <p>Visas dienas norises ir vienā vietā.</p>
      </div>

      <a
        class="location-footer__map"
        href={weddingVenue.wazeUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={`Atvērt ${weddingVenue.name} Waze`}
      >
        <span>Atvērt Waze</span>
        <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </div>
</section>

<style>
  .location-section {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(74px, 7.5vh, 100px) clamp(28px, 4vh, 48px);
  }

  .location-section::before {
    content: "";
    position: absolute;
    width: min(42vw, 620px);
    aspect-ratio: 1;
    right: -15%;
    top: 5%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(129, 120, 81, 0.09) 0%,
      rgba(129, 120, 81, 0) 70%
    );
    pointer-events: none;
  }

  .location-shell {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .location-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
    align-items: end;
    gap: clamp(34px, 7vw, 100px);
    margin-bottom: clamp(20px, 3vh, 34px);
  }

  .location-heading__aside {
    max-width: 38rem;
    margin: 0 0 0.18rem;
    padding-left: 24px;
    border-left: 1px solid color-mix(in srgb, var(--gold) 48%, transparent);
  }

  .location-heading__copy {
    max-width: 35rem;
    margin: 0;
    color: color-mix(in srgb, var(--olive-dark) 78%, transparent);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.62;
  }

  .location-heading__venue {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 10px 0 0;
    color: color-mix(in srgb, var(--olive-dark) 58%, transparent);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .location-heading__venue span:first-child {
    color: color-mix(in srgb, var(--olive-dark) 82%, transparent);
  }

  .location-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.48fr) minmax(300px, 0.82fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.45vw, 20px);
    height: clamp(410px, 52vh, 545px);
    min-height: 410px;
  }

  .location-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 0;
    border-radius: clamp(18px, 2vw, 28px);
    background: #cec8b8;
    box-shadow: 0 18px 54px rgba(46, 43, 31, 0.1);
  }

  .location-card--feature {
    grid-row: 1 / 3;
  }

  .location-card__image {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-color: #cec8b8;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    transform: scale(1.01);
    transition:
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /*
   * Stronger bottom shading is deliberate: the photography still stays visible,
   * but the text remains readable regardless of which final images you use.
   */
  .location-card__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgba(13, 16, 10, 0.13) 0%,
        rgba(13, 16, 10, 0.03) 37%,
        rgba(13, 16, 10, 0.18) 56%,
        rgba(13, 16, 10, 0.84) 100%
      ),
      linear-gradient(105deg, rgba(26, 31, 20, 0.2), transparent 54%);
  }

  .location-card--secondary .location-card__shade,
  .location-card--stay .location-card__shade {
    background:
      linear-gradient(
        180deg,
        rgba(13, 16, 10, 0.16) 0%,
        rgba(13, 16, 10, 0.05) 30%,
        rgba(13, 16, 10, 0.34) 57%,
        rgba(13, 16, 10, 0.88) 100%
      ),
      linear-gradient(105deg, rgba(26, 31, 20, 0.18), transparent 58%);
  }

  .location-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: inherit;
    pointer-events: none;
  }

  .location-card__meta {
    position: absolute;
    top: clamp(18px, 2vw, 26px);
    left: clamp(20px, 2.4vw, 30px);
    right: clamp(20px, 2.4vw, 30px);
    display: grid;
    grid-template-columns: auto minmax(34px, 1fr) auto;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(0.63rem, 0.58vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(10, 13, 8, 0.62);
  }

  .location-card__number {
    opacity: 0.8;
  }

  .location-card__meta-line {
    height: 1px;
    background: rgba(255, 255, 255, 0.52);
    box-shadow: 0 1px 8px rgba(10, 13, 8, 0.28);
  }

  .location-card__content {
    position: absolute;
    inset: auto clamp(22px, 2.6vw, 34px) clamp(22px, 2.7vw, 32px);
    color: #fff;
  }

  .location-card__text {
    min-width: 0;
    max-width: 40rem;
  }

  .location-card__content h3 {
    max-width: 18ch;
    margin: 0 0 8px;
    color: #fff !important;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.2rem, 3.6vw, 3.8rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
    text-shadow: 0 3px 24px rgba(7, 10, 6, 0.72);
  }

  .location-card--secondary .location-card__content h3,
  .location-card--stay .location-card__content h3 {
    max-width: 15ch;
    font-size: clamp(1.85rem, 2.35vw, 2.7rem);
  }

  .location-card__content p {
    max-width: 42ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.94) !important;
    font-size: clamp(0.82rem, 0.83vw, 0.92rem);
    font-weight: 500;
    line-height: 1.5;
    text-shadow: 0 2px 16px rgba(7, 10, 6, 0.72);
  }

  .location-card__personal {
    margin-bottom: 8px !important;
    color: rgba(238, 221, 163, 0.98) !important;
    font-size: 0.68rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .location-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(14px, 2vh, 22px);
  }

  .location-footer__note {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: color-mix(in srgb, var(--olive-dark) 62%, transparent);
  }

  .location-footer__note > span {
    flex: 0 0 auto;
    width: 38px;
    height: 1px;
    background: color-mix(in srgb, var(--gold) 52%, transparent);
  }

  .location-footer__note p {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.4;
    letter-spacing: 0.015em;
  }

  .location-footer__map {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 0 0 5px;
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 64%, transparent);
    color: var(--olive-dark);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    text-decoration: none;
    transition:
      gap 200ms ease,
      border-color 200ms ease,
      opacity 200ms ease;
  }

  .location-footer__map:hover,
  .location-footer__map:focus-visible {
    gap: 18px;
    border-color: var(--olive-dark);
  }

  .location-footer__map:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--gold) 72%, white);
    outline-offset: 5px;
  }

  @media (hover: hover) and (pointer: fine) {
    .location-card:hover .location-card__image {
      transform: scale(1.045);
      filter: saturate(0.96) contrast(1.03);
    }
  }

  /* Keep the whole desktop composition inside short laptop screens. */
  @media (min-width: 921px) and (max-height: 820px) {
    .location-section {
      min-height: 100svh;
      padding-block: 66px 20px;
    }

    .location-heading {
      margin-bottom: 16px;
    }

    .location-heading .section-title {
      font-size: clamp(3.1rem, 6.2vh, 4.8rem);
    }

    .location-heading__copy {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .location-heading__venue {
      margin-top: 7px;
      font-size: 0.7rem;
    }

    .location-showcase {
      height: min(51vh, 450px);
      min-height: 350px;
    }

    .location-card__content {
      bottom: 22px;
    }

    .location-card--feature .location-card__content h3 {
      font-size: clamp(2.35rem, 5.2vh, 3.35rem);
    }

    .location-card--secondary .location-card__content h3,
    .location-card--stay .location-card__content h3 {
      font-size: clamp(1.7rem, 3.5vh, 2.2rem);
    }

    .location-card__content p {
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .location-footer {
      margin-top: 10px;
    }
  }

  @media (max-width: 920px) {
    .location-section {
      min-height: auto;
      display: block;
      padding-block: clamp(72px, 10vw, 96px) clamp(48px, 8vw, 72px);
    }

    .location-heading {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .location-heading__aside {
      max-width: 620px;
    }

    .location-showcase {
      height: auto;
      min-height: 0;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(430px, 58vw) minmax(290px, 40vw);
    }

    .location-card--feature {
      grid-column: 1 / 3;
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .location-heading__aside {
      padding-left: 16px;
    }

    .location-heading__copy {
      font-size: 0.9rem;
      line-height: 1.58;
    }

    .location-heading__venue {
      gap: 5px;
      font-size: 0.7rem;
    }

    .location-showcase {
      display: flex;
      gap: 14px;
      width: calc(100% + 36px);
      margin-inline: -18px;
      padding: 4px 18px 18px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
    }

    .location-showcase::-webkit-scrollbar {
      display: none;
    }

    .location-card,
    .location-card--feature,
    .location-card--secondary,
    .location-card--stay {
      flex: 0 0 min(84vw, 355px);
      width: min(84vw, 355px);
      min-height: 490px;
      scroll-snap-align: center;
      border-radius: 24px;
    }

    .location-card__meta {
      top: 18px;
      left: 18px;
      right: 18px;
      gap: 9px;
      font-size: 0.62rem;
    }

    .location-card__content {
      inset: auto 20px 24px;
    }

    .location-card__content h3,
    .location-card--secondary .location-card__content h3,
    .location-card--stay .location-card__content h3 {
      max-width: 14ch;
      margin-bottom: 9px;
      font-size: clamp(2.35rem, 11vw, 3.2rem);
    }

    .location-card__content p {
      max-width: 30ch;
      font-size: 0.86rem;
    }

    .location-footer {
      align-items: flex-start;
      gap: 18px;
      margin-top: 10px;
    }

    .location-footer__note {
      gap: 8px;
    }

    .location-footer__note > span {
      width: 22px;
    }

    .location-footer__note p,
    .location-footer__map {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 420px) {
    .location-footer {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .location-card__image,
    .location-footer__map {
      transition: none;
    }
  }
</style>
