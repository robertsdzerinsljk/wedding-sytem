---
import { weddingVenue } from "../../data/wedding";
---

<a class="camera-fab" href="#kamera" aria-label="Atvērt vienreizlietojamās kameras sadaļu">
  <span class="camera-fab__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M7.2 6.4 8.7 4h6.6l1.5 2.4h2.4A2.8 2.8 0 0 1 22 9.2v7A2.8 2.8 0 0 1 19.2 19H4.8A2.8 2.8 0 0 1 2 16.2v-7a2.8 2.8 0 0 1 2.8-2.8h2.4Zm4.8 3a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Zm0 1.7a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8Z" fill="currentColor"/>
    </svg>
  </span>
  <span class="camera-fab__label">Kamera</span>
</a>

<div class="mobile-action-tray" data-mobile-action-tray>
  <a class="mobile-action-tray__camera" href="#kamera" aria-label="Atvērt disposable kameru">
    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
      <path d="M7.2 6.8 8.7 4.6h6.6l1.5 2.2h2.1a2.4 2.4 0 0 1 2.4 2.4v7.6a2.4 2.4 0 0 1-2.4 2.4H5.1a2.4 2.4 0 0 1-2.4-2.4V9.2a2.4 2.4 0 0 1 2.4-2.4h2.1Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.55" />
      <circle cx="12" cy="13" r="3.4" fill="none" stroke="currentColor" stroke-width="1.55" />
    </svg>
  </a>

  <span class="mobile-action-tray__label">Disposable kamera</span>
</div>

<div class="attendance-bubble" id="attendance-bubble" data-attendance-bubble aria-hidden="true">
  <div class="attendance-bubble__copy">
    <h2>Vai būsiet ar mums?</h2>
    <p data-attendance-message>Mums būtu patiess prieks par jūsu klātbūtni!</p>
  </div>

  <div class="attendance-bubble__actions" aria-label="Atbildēt par dalību">
    <button class="attendance-choice attendance-choice--yes" type="button" data-attendance-choice="yes">
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="m5 12.3 4.3 4.2L19 6.8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" />
      </svg>
      Jā, būsim!
    </button>
    <button class="attendance-choice attendance-choice--no" type="button" data-attendance-choice="no">
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="m7 7 10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.9" />
      </svg>
      Diemžēl nevarēsim
    </button>
  </div>
</div>

<a
  class="waze-fab"
  href={weddingVenue.wazeUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Atvērt Niedras lokāciju Waze"
>
  <img src="/images/waze-button.png" alt="" aria-hidden="true" draggable="false" />
</a>

<button
  class="scroll-top-fab"
  type="button"
  aria-label="Ritināt uz lapas sākumu"
  data-scroll-top
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M6.5 14.5 12 9l5.5 5.5" />
  </svg>
</button>

<style>
  .scroll-top-fab {
    position: fixed;
    right: var(--scroll-top-right, max(16px, env(safe-area-inset-right)));
    top: var(--scroll-top-top, 50%);
    z-index: 50;

    display: grid;
    place-items: center;
    width: var(--scroll-top-size, 62px);
    height: var(--scroll-top-size, 62px);
    padding: 0;

    border: 0;
    border-radius: 50%;
    background: #333A24;
    color: #F6F1E7;
    box-shadow: 0 12px 28px rgba(31, 35, 22, 0.18);
    cursor: pointer;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-50%) scale(0.92);

    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  .scroll-top-fab.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(-50%) scale(1);
  }

  .scroll-top-fab:hover {
    transform: translateY(-50%) scale(1.05);
  }

  .scroll-top-fab:focus-visible {
    outline: 2px solid #F6F1E7;
    outline-offset: 4px;
  }

  .scroll-top-fab svg {
    width: 25px;
    height: 25px;
  }

  .scroll-top-fab path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 560px) {
    .scroll-top-fab {
      right: var(--scroll-top-right, max(10px, env(safe-area-inset-right)));
      width: var(--scroll-top-size, 54px);
      height: var(--scroll-top-size, 54px);
    }

    .scroll-top-fab svg {
      width: 22px;
      height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-top-fab {
      transition: none;
    }
  }
</style>

<script>
  const scrollTopButton = document.querySelector<HTMLElement>("[data-scroll-top]");
  const wazeButton = document.querySelector<HTMLElement>(".waze-fab");
  const firstSection = document.querySelector<HTMLElement>("#musu-diena");

  if (scrollTopButton) {
    const syncWithWaze = () => {
      if (!wazeButton) return;

      const rect = wazeButton.getBoundingClientRect();

      // Exact horizontal mirror of the Waze button:
      // Waze's left inset becomes this button's right inset.
      scrollTopButton.style.setProperty("--scroll-top-right", `${rect.left}px`);
      scrollTopButton.style.setProperty(
        "--scroll-top-top",
        `${rect.top + rect.height / 2}px`,
      );
      scrollTopButton.style.setProperty("--scroll-top-size", `${rect.width}px`);
    };

    const updateVisibility = () => {
      const show = firstSection
        ? firstSection.getBoundingClientRect().bottom <= 0
        : window.scrollY > window.innerHeight;

      scrollTopButton.classList.toggle("is-visible", show);
    };

    syncWithWaze();
    updateVisibility();

    window.addEventListener("resize", syncWithWaze);
    window.addEventListener("scroll", updateVisibility, { passive: true });

    scrollTopButton.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    });
  }
</script>
