<section class="wedding-section wedding-section--camera" id="kamera">
  <div class="section-inner section-inner--center">
    <p class="section-kicker section-kicker--light">Disposable camera</p>
    <h2 class="camera-title">Noķeriet mirkļus, kurus mēs neredzam</h2>
    <p class="camera-copy">
      Kāzu dienā šeit var atvērt kameru un augšupielādēt kadrus kopīgajā albumā.
      Mobilajā versijā kamera vienmēr ir viena pieskāriena attālumā.
    </p>
    <button class="camera-launch" type="button">
      <span aria-hidden="true">◎</span>
      Atvērt kameru
    </button>
    <p class="camera-limit">24 kadri uz ielūgumu · bildes var atklāt pēc kāzām</p>
  </div>
</section>
